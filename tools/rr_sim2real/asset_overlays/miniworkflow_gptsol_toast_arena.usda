#usda 1.0
(
    defaultPrim = "Toaster"
    doc = "Fixed-base compatibility only: move articulation root to Body. Source geometry and joints unchanged."
)
def Xform "Toaster" (
    delete apiSchemas = ["PhysicsArticulationRootAPI", "PhysxArticulationAPI"]
    prepend references = @./miniworkflow_gptsol_toast.usd@</Toaster>
)
{
    over "Body" (
        prepend apiSchemas = ["PhysicsArticulationRootAPI"]
    )
    {
    }
}
