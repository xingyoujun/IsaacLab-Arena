                int[] faceVertexIndices = [15, 11, 3, 4, 8, 2, 10, 12, 8, 10, 8, 11, 14, 8, 12, 13, 11, 15, 13, 12, 10, 13, 10, 11, 1, 15, 3, 1, 3, 2, 9, 11, 8, 9, 8, 7, 9, 7, 11, 6, 8, 4, 6, 7, 8, 6, 4, 7, 5, 7, 4, 5, 3, 11, 5, 11, 7, 0, 1, 2, 0, 2, 8, 0, 8, 14, 0, 14, 15, 0, 15, 1, 13, 15, 14, 13, 14, 12, 5, 4, 2, 5, 2, 3]
