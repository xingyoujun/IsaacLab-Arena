#usda 1.0
(
    defaultPrim = "AluminumStock"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "AluminumStock" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
)
{
    float physics:mass = 0.297675
    def Cube "Stock" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        double size = 1
        double3 xformOp:scale = (0.07, 0.045, 0.035)
        uniform token[] xformOpOrder = ["xformOp:scale"]
        rel material:binding = </AluminumStock/Material>
    }
    def Material "Material"
    {
        token outputs:surface.connect = </AluminumStock/Material/Shader.outputs:surface>
        def Shader "Shader"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.63, 0.65, 0.68)
            float inputs:metallic = 0.9
            float inputs:roughness = 0.32
            token outputs:surface
        }
    }
}
